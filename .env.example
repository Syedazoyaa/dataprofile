APP_ENV=development
MAX_PROFILES_PER_REQUEST=2000
LOG_LEVEL=INFO
# Comma-separated browser origins. "*" is suitable only for local development.
CORS_ORIGINS=*
# Optional fixed date (YYYY-MM-DD) for historically reproducible populations.
# If omitted, the service records its process-start date in every profile.
GENERATION_REFERENCE_DATE=2026-10-26
